{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bradygaster/squad/scripts/release/manifest.schema.json",
  "title": "Squad 2.0 verification manifest",
  "description": "Machine-readable release evidence generated by scripts/release/build-manifest.mjs at an exact commit. Counts in every section must sum; carried/anchorPresent/contentEvidencePresent are presence facts, behavioralEvidence is separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "generator", "target", "stack", "ci", "packages", "lockfiles", "tests", "closure", "behavioralEvidence", "comparison", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "squad-2.0-verification-manifest/v2" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["script", "scriptSha256", "node", "mode"],
      "properties": { "script": { "type": "string" }, "scriptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "node": { "type": "string" }, "mode": { "enum": ["ci", "local"] } }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["commit", "tree", "branch", "version", "immutableVerification"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "branch": { "type": ["string", "null"] }, "version": { "type": "string" },
        "immutableVerification": { "type": "object", "required": ["commitCommand", "treeCommand"], "properties": { "commitCommand": { "type": "string" }, "treeCommand": { "type": "string" } } }
      }
    },
    "stack": {
      "type": "object", "additionalProperties": false, "required": ["id", "repo", "base", "mergedDev", "layers", "allLayerTreesEqual", "layersUnavailable"],
      "properties": {
        "id": { "type": "integer" }, "repo": { "type": "string" }, "base": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "mergedDev": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "layers": { "type": "array", "items": { "type": "object", "required": ["layer", "pr", "head", "squash", "headTree", "squashTree", "treeEqual", "verificationCommand"], "properties": { "layer": { "type": "string" }, "pr": { "type": "integer" }, "head": { "type": "string" }, "squash": { "type": "string" }, "headTree": { "type": ["string", "null"] }, "squashTree": { "type": ["string", "null"] }, "treeEqual": { "type": ["boolean", "null"] }, "verificationCommand": { "type": "string" } } } },
        "allLayerTreesEqual": { "type": ["boolean", "null"] }, "layersUnavailable": { "type": "integer", "minimum": 0 }
      }
    },
    "ci": {
      "type": "object", "additionalProperties": false, "required": ["citedRun", "thisRun"],
      "properties": {
        "citedRun": { "type": "object", "required": ["id", "url", "headSha", "matchesTarget", "consoleSummary"], "properties": { "id": { "type": "integer" }, "url": { "type": "string" }, "headSha": { "type": "string" }, "matchesTarget": { "type": "boolean" }, "conclusion": { "type": ["string", "null"] }, "consoleSummary": { "type": "object" } } },
        "thisRun": { "type": ["object", "null"], "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "workflow": { "type": "string" }, "attempt": { "type": "string" } } }
      }
    },
    "packages": {
      "type": "object", "additionalProperties": false, "required": ["@bradygaster/squad-sdk", "@bradygaster/squad-cli"],
      "properties": {
        "@bradygaster/squad-sdk": { "$ref": "#/$defs/package" },
        "@bradygaster/squad-cli": { "$ref": "#/$defs/package" }
      }
    },
    "lockfiles": {
      "type": "object", "additionalProperties": false, "required": ["files", "registryEntries", "violations", "deniedPatterns", "ok"],
      "properties": { "files": { "type": "integer" }, "registryEntries": { "type": "integer" }, "violations": { "type": "integer" }, "deniedPatterns": { "type": "array", "items": { "type": "string" } }, "ok": { "type": "boolean" }, "externalNpmCi": { "type": ["object", "null"] } }
    },
    "tests": {
      "type": "object", "additionalProperties": false, "required": ["source", "numTotalTests", "byStatus", "byCategory", "countsSum", "unlistedTests", "skippedFiles"],
      "properties": { "source": { "type": "string" }, "platform": { "type": "string" }, "numTotalTests": { "type": "integer" }, "byStatus": { "type": "object" }, "byCategory": { "type": "object" }, "countsSum": { "type": "boolean" }, "unlistedTests": { "type": "integer" }, "skippedFiles": { "type": "array", "items": { "type": "string" } }, "reconciliationFile": { "type": ["string", "null"] } }
    },
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["trackedItems", "carried", "notCarried", "contentEvidencePresent", "presenceOnly", "anchorPresent", "sums", "items"],
      "properties": {
        "trackedItems": { "type": "integer" }, "carried": { "type": "integer" }, "notCarried": { "type": "integer" }, "contentEvidencePresent": { "type": "integer" }, "presenceOnly": { "type": "integer" }, "anchorPresent": { "type": "integer" },
        "sums": { "type": "object", "required": ["carriedPlusNotCarriedEqualsTracked", "contentPlusPresenceEqualsCarried"], "properties": { "carriedPlusNotCarriedEqualsTracked": { "const": true }, "contentPlusPresenceEqualsCarried": { "const": true } } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/closureItem" } }
      }
    },
    "behavioralEvidence": {
      "type": "object", "additionalProperties": false, "required": ["treeEquality", "citedCiRun", "regressionTests"],
      "properties": {
        "treeEquality": { "type": "object", "required": ["layersChecked", "layersEqual", "layersUnavailable"], "properties": { "layersChecked": { "type": "integer" }, "layersEqual": { "type": "integer" }, "layersUnavailable": { "type": "integer" } } },
        "citedCiRun": { "type": "object", "required": ["url", "headSha", "matchesTarget"], "properties": { "url": { "type": "string" }, "headSha": { "type": "string" }, "matchesTarget": { "type": "boolean" }, "conclusion": { "type": ["string", "null"] } } },
        "regressionTests": { "type": "object", "required": ["titlesCited", "titlesDefinedInTree", "titlesExecutedInReport", "reportAvailable"], "properties": { "titlesCited": { "type": "integer" }, "titlesDefinedInTree": { "type": "integer" }, "titlesExecutedInReport": { "type": "integer" }, "reportAvailable": { "type": "boolean" } } }
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false, "required": ["baselineManifest", "baselineCommit"],
      "properties": {
        "baselineManifest": { "type": ["string", "null"] }, "baselineCommit": { "type": ["string", "null"] }, "diffStat": { "type": ["object", "null"] }, "firstParentCommits": { "type": ["array", "null"] },
        "closureItemsBefore": { "type": ["integer", "null"] }, "closureItemsCarriedNow": { "type": ["integer", "null"] }, "packageVersions": { "type": ["object", "null"] }, "verdict": { "type": ["string", "null"] }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "package": {
      "type": "object", "required": ["name", "version", "exportsCount"],
      "properties": {
        "name": { "type": "string" }, "version": { "type": "string" }, "exportsCount": { "type": "integer" }, "sdkDependency": { "type": ["string", "null"] },
        "tarball": { "type": ["object", "null"], "properties": { "filename": { "type": "string" }, "bytes": { "type": "integer" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "integrity": { "type": "string", "pattern": "^sha512-" }, "fileCount": { "type": "integer" }, "exportTargetsMissing": { "type": "integer" }, "privacyHits": { "type": "integer" }, "privacyAllowlisted": { "type": "integer" } } }
      }
    },
    "closureItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "finding", "originalLayer", "evidenceLocations", "evidenceLocationsPresent", "anchor", "anchorLocation", "anchorKind", "anchorPresent", "implementationSymbol", "regressionTests", "contentEvidencePresent", "presenceOnly", "carried"],
      "properties": {
        "id": { "type": "string" }, "groupedFrom": { "type": "string" }, "finding": { "type": "string" }, "originalLayer": { "type": "string" },
        "evidenceLocations": { "type": "array", "items": { "type": "string" } }, "evidenceLocationsPresent": { "type": "boolean" },
        "anchor": { "type": ["string", "null"] }, "anchorLocation": { "type": ["string", "null"] }, "anchorKind": { "enum": ["implementation", "test", "doc-only", "absent"] }, "anchorPresent": { "type": "boolean" },
        "implementationSymbol": { "type": ["object", "null"], "properties": { "symbol": { "type": "string" }, "file": { "type": "string" } } },
        "regressionTests": { "type": "array", "items": { "type": "object", "required": ["title", "definedIn", "executedInCitedReport"], "properties": { "title": { "type": "string" }, "definedIn": { "type": ["string", "null"] }, "executedInCitedReport": { "type": ["boolean", "null"] } } } },
        "contentEvidencePresent": { "type": "boolean" }, "presenceOnly": { "type": "boolean" }, "carried": { "type": "boolean" },
        "sourceEvidence": { "type": "string" }, "lockingTests": { "type": "string" }
      }
    }
  }
}
