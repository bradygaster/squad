<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>Squad.Agents.AI</PackageId>
    <Title>Squad Agents AI</Title>
    <Description>Community SquadAgent for Microsoft Agent Framework. Exposes the Squad multi-agent CLI as an AIAgent that can be composed into any MAF app or workflow.</Description>
    <Authors>Tamir Dresher</Authors>
    <PackageTags>squad;agents;ai;copilot;maf;multi-agent</PackageTags>
    <PackageProjectUrl>https://github.com/bradygaster/squad</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bradygaster/squad.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Prerelease because Microsoft.Agents.AI.GitHub.Copilot 1.15.0-rc1 (below) is itself a
      prerelease package. A STABLE Squad.Agents.AI depending on a prerelease package makes
      `dotnet pack` emit NU5104 ("A stable release ... should not have a prerelease
      dependency"). Prior releases (0.2.0 through 0.5.5) stayed stable and carried that
      warning silently; this bump actually resolves it instead of suppressing it, and
      matches the "-rc1" convention already used by the adapter dependency itself. Bump
      back to a stable version only once Microsoft.Agents.AI.GitHub.Copilot ships a GA
      release (dev->main promotions already require bumping this by hand; see
      squad-agents-ai-release.yml, which refuses to publish a prerelease Version from main).
    -->
    <Version>0.5.6-rc1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="samples/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Squad.Agents.AI.Tests" />
    <PackageReference Include="Microsoft.Agents.AI.GitHub.Copilot" Version="1.19.0" />
    <!--
      Direct reference to GitHub.Copilot.SDK so its build/ targets fire during our build.
      Without this, the SDK's MSBuild download/copy targets only flow to projects with a
      DIRECT PackageReference; transitive consumers (us to MAF to SDK) get only the DLL,
      not the binary download. With the direct ref, the SDK downloads copilot.exe into
      bin/.../runtimes/{rid}/native/ and ContentWithTargetPath propagates it to consumers.
      Once microsoft/agent-framework#6457 merges, this will no longer be required.

      Version is $(SquadCopilotSdkVersion) (see Directory.Build.props) rather than a
      literal, so it can never drift out of sync with the buildTransitive/Squad.Agents.AI.props
      bridge generated by GenerateCopilotSdkVersionBridge below, or with the
      _MicrosoftAgentsAICopilotSdkVersion override that keeps test/Squad.Agents.AI.Tests and
      samples/Squad.Agents.AI.Sample resolving the SAME native Copilot CLI build as this
      project (see Directory.Build.props for the full explanation).
    -->
    <PackageReference Include="GitHub.Copilot.SDK" Version="$(SquadCopilotSdkVersion)" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Ship our own buildTransitive/Squad.Agents.AI.props so REAL external NuGet consumers
    (anyone who runs `dotnet add package Squad.Agents.AI`, not just this repo's internal
    test/sample ProjectReferences, which Directory.Build.props already covers) also get
    the correct native Copilot CLI payload; see Directory.Build.props for the full
    explanation of why Microsoft.Agents.AI.GitHub.Copilot's own bridge otherwise resolves
    the wrong (older) GitHub.Copilot.SDK version for anyone without a direct
    PackageReference to GitHub.Copilot.SDK, which every external consumer of
    Squad.Agents.AI is (that direct reference only exists on this project, not on
    consumers of the packed nupkg).

    The file content is generated here (not checked in statically) so it can never drift
    out of sync with $(SquadCopilotSdkVersion) / the GitHub.Copilot.SDK PackageReference
    above; mirroring exactly how Microsoft.Agents.AI.GitHub.Copilot.props itself is
    "generated at [that package's] pack time" per its own doc comments.

    Generated with System.Xml.Linq (XDocument/XElement) via an inline RoslynCodeTaskFactory
    task, not hand-built entity-escaped strings, so the interpolated
    $(SquadCopilotSdkVersion) value is guaranteed to be escaped correctly for XML by the
    same writer .NET itself uses, regardless of what characters that property ever
    contains.
  -->
  <UsingTask TaskName="GenerateCopilotSdkVersionBridgeProps" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SdkVersion ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          var doc = new XDocument(
            new XComment(
              " Generated at Squad.Agents.AI pack time. Do not edit, see " + "\n" +
              "   GenerateCopilotSdkVersionBridge in Squad.Agents.AI.csproj. " + "\n" + "\n" +
              "   Microsoft.Agents.AI.GitHub.Copilot's own buildTransitive bridge " + "\n" +
              "   (Microsoft.Agents.AI.GitHub.Copilot.targets) imports GitHub.Copilot.SDK's " + "\n" +
              "   build/ CLI-download targets from a path keyed on the " + "\n" +
              "   _MicrosoftAgentsAICopilotSdkVersion property, which (unless overridden) " + "\n" +
              "   defaults to the SDK version THAT PACKAGE was built against (its nuspec " + "\n" +
              "   dependency floor), not the version Squad.Agents.AI actually references. " + "\n" +
              "   Setting it here (unconditionally, so it wins regardless of NuGet's props " + "\n" +
              "   import order relative to that package) makes every consumer of " + "\n" +
              "   Squad.Agents.AI resolve the SAME GitHub.Copilot.SDK build/ targets, and " + "\n" +
              "   therefore the same native Copilot CLI / runtime.node payload, that " + "\n" +
              "   Squad.Agents.AI itself does. "
            ),
            new XElement(
              "Project",
              new XElement(
                "PropertyGroup",
                new XElement("_MicrosoftAgentsAICopilotSdkVersion", SdkVersion)
              )
            )
          );
          doc.Save(OutputPath);
        ]]>
      </Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateCopilotSdkVersionBridge" BeforeTargets="GenerateNuspec;_GetPackageFiles">
    <PropertyGroup>
      <_CopilotSdkVersionBridgePropsPath>$(IntermediateOutputPath)Squad.Agents.AI.props</_CopilotSdkVersionBridgePropsPath>
    </PropertyGroup>
    <GenerateCopilotSdkVersionBridgeProps SdkVersion="$(SquadCopilotSdkVersion)" OutputPath="$(_CopilotSdkVersionBridgePropsPath)" />
    <ItemGroup>
      <None Include="$(_CopilotSdkVersionBridgePropsPath)" Pack="true" PackagePath="buildTransitive\Squad.Agents.AI.props" Visible="false" />
      <FileWrites Include="$(_CopilotSdkVersionBridgePropsPath)" />
    </ItemGroup>
  </Target>
</Project>
